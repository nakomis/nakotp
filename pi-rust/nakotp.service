[Unit]
Description=NakOTP TOTP server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/nakotp --config /etc/nakotp/config.toml
Restart=on-failure
RestartSec=5

# Run as a dedicated user (create with: sudo useradd -r -s /sbin/nologin nakotp)
User=nakotp
Group=nakotp

# Allow binding to privileged ports (80, 443) without running as root
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

# Let certbot's post-renewal hook restart this service
# Add to /etc/letsencrypt/renewal-hooks/post/reload-nakotp.sh:
#   systemctl restart nakotp

[Install]
WantedBy=multi-user.target
